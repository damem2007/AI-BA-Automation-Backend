DATABASE_URL=postgresql://user:password@localhost:5432/ba_artifacts
OPENAI_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AUTH_MODE=hybrid
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=ba-optimization-local
JWT_AUDIENCE=ba-optimization-api
JWT_ACCESS_TOKEN_MINUTES=60
LOCAL_ROOT_EMAIL=root@ba-optimization.local
LOCAL_ROOT_USERNAME=root
LOCAL_ROOT_NAME=Local Root Administrator
LOCAL_ROOT_PASSWORD=replace-before-startup

# Future enterprise IAM / Microsoft Entra configuration
OIDC_ISSUER=
OIDC_AUDIENCE=ba-optimization-api
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_TENANT_ID=
OIDC_REQUIRED_SCOPES=access_as_user

# Transactional onboarding mail. Leave unset to keep invitations pending configuration.
FRONTEND_URL=http://192.168.1.69:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=dahunsidamilola1@gmail.com
SMTP_PASSWORD=myaccount.google.com/apppasswords  # ← This is an app password from myaccount.google.com/apppasswords
SMTP_FROM=no-reply@ba_automation.com
SMTP_USE_TLS=true

REDIS_URL=redis://localhost:6379/0
ANALYSIS_REQUIRE_REDIS=false
ANALYSIS_JOB_STALE_SECONDS=7200
ANALYSIS_MAX_CONCURRENT_JOBS=2
ANALYSIS_MAX_QUEUED_JOBS=20
ANALYSIS_RATE_LIMIT_REQUESTS=10
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=60
ANALYSIS_JOB_RETENTION_SECONDS=3600

ANALYSIS_MAX_FILES=10
ANALYSIS_MAX_FILE_BYTES=15728640
ANALYSIS_MAX_TOTAL_FILE_BYTES=41943040
ANALYSIS_MAX_SOURCE_TEXT_CHARS=200000
ANALYSIS_MAX_EXTRACTED_CHARS_PER_FILE=50000
ANALYSIS_UPLOAD_TTL_SECONDS=3600
ANALYSIS_MAX_STAGED_MEMORY_BYTES=134217728
ANALYSIS_PDF_TEXT_QUALITY_MIN_CHARS=250
OPENAI_MULTIMODAL_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
